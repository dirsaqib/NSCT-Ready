# Database
DATABASE_URL="postgresql://nsct:change-me@localhost:5432/nsct?schema=public"

# Auth (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# SMTP for email sign-in links, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=""
EMAIL_FROM="NSCT Ready <no-reply@example.com>"

# AI tutor (Anthropic API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_FAST="claude-haiku-5-5"
ANTHROPIC_MODEL_SMART="claude-sonnet-5-5"
AI_DAILY_LIMIT=40

# Security
# 32 bytes, base64. Encrypts two-factor secrets. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Bearer token for /api/cron/notify and /api/cron/nightly
CRON_SECRET=""
APP_VERSION="2.0.0"

# Payments: JazzCash (sandbox first)
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_URL="https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/"

# Payments: Easypaisa hosted checkout (sandbox first)
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_ACCOUNT_NUM=""
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_URL="https://easypaystg.easypaisa.com.pk/easypay/Index.jsf"
EASYPAISA_INQUIRY_URL=""

# Coding questions (Judge0, self-hosted or RapidAPI)
JUDGE0_URL="http://localhost:2358"
JUDGE0_KEY=""

# SMS gateway (any HTTP gateway that accepts to, message, sender)
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER="NSCTReady"

# WhatsApp Cloud API (approved template with two body parameters: title, body)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="nsct_notice"
